# O modo hodpro usa o fluxo autenticado do gateway e é o padrão.
PANEL_DATA_MODE=hodpro
HODPRO_API_BASE=https://hodpro-api.patriksantos494.workers.dev/api
BROWSER_CHANNEL=chrome
API_TIMEOUT_MS=60000

# A senha nunca deve ser adicionada a este arquivo. Informe-a apenas na tela do app.

