# Copie este arquivo para .env e preencha apenas no seu computador.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# Opcional: JWT temporário de um usuário autenticado. Nunca use service_role/secret.
# O MVP não renova esse JWT; ao expirar, gere uma nova sessão.
# SUPABASE_ACCESS_TOKEN=

SUPABASE_ACCOUNTS_TABLE=tool_accounts
SUPABASE_TOOLS_RELATION=tools
ACCOUNT_LIMIT=500
BROWSER_CHANNEL=chrome

# O app lê URL e chave do comando inicial de Exemplo.txt quando .env não existe.
# Desative depois de configurar .env.
ALLOW_EXAMPLE_CONFIG_FALLBACK=true
